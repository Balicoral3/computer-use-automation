# LLM provider configuration.
#
# This project speaks the OpenAI-compatible chat completions API, so any
# provider that exposes that interface will work. Fill in the three values
# below for whichever provider you use.
#
# Google Gemini (free tier):
#   LLM_API_KEY=AIza...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.0-flash
#
# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Groq:
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
LLM_API_KEY=replace-me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Target app (mock legacy bank)
TARGET_USERNAME=teller1
TARGET_PASSWORD=password123
TARGET_APP_BASE_URL=http://127.0.0.1:5000
TARGET_APP_HOST=127.0.0.1
TARGET_APP_PORT=5000

# Safety
ALLOWED_DOMAINS=127.0.0.1,localhost
MAX_STEPS=25
STEP_TIMEOUT_SEC=10
GLOBAL_TIMEOUT_SEC=180

# Evidence
EVIDENCE_DIR=./evidence
ARTIFACTS_DIR=./artifacts